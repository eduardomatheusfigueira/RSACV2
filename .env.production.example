# ==============================================================================
# Revsist — Modelo de Configuração de Produção (.env)
# ==============================================================================
#
# INSTRUÇÕES DE SEGURANÇA (doc 40 §40.7.3, doc 41 Tarefa 4.9):
#   1. Copie este arquivo para .env no servidor: cp .env.production.example .env
#   2. Preencha todos os segredos obrigatórios gerados com alta entropia.
#   3. Restrinja as permissões imediatamente: chmod 0600 .env && chown root:root .env
#   4. NUNCA adicione o arquivo .env ao repositório git.
# ==============================================================================

# ── Perímetro e Perfil ────────────────────────────────────────────────────────
RSAC_DEPLOYMENT_PROFILE=server
RSAC_APP_VERSION=2.0.0
RSAC_DEBUG=false

# ── Chave Mestra da Cifra de Segredos (OBRIGATÓRIO em perfil server) ──────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSAC_SECRET_KEY=SUBSTITUIR_POR_CHAVE_MESTRA_ALEATORIA_DE_32_BYTES_MINIMO

# ── Domínio Público e Rede ────────────────────────────────────────────────────
RSAC_PUBLIC_DOMAIN=revsist.com
RSAC_PUBLIC_BASE_URL=https://revsist.com
RSAC_TRUSTED_HOSTS=revsist.com,www.revsist.com
RSAC_CORS_ORIGINS=https://revsist.com,https://www.revsist.com
RSAC_CONTACT_EMAIL=contato@revsist.org

# ── Banco de Dados PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=rsac
POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE_DO_BANCO_POSTGRES
POSTGRES_DB=rsac

# ── Autenticação Institucional Google OAuth (Opcional na v1) ──────────────────
# Obter no Google Cloud Console (OAuth 2.0 Client ID -> Web Application)
RSAC_GOOGLE_CLIENT_ID=
RSAC_GOOGLE_CLIENT_SECRET=

# ── Política de Admissão (Opcional - Vazio = Aberto) ──────────────────────────
# Domínios ou e-mails autorizados (ex: @usp.br, @ufrgs.br)
RSAC_SIGNUP_ALLOWLIST=

# ── Limites de Recurso (doc 40 §40.7.5) ───────────────────────────────────────
RSAC_MAX_UPLOAD_MB=50
RSAC_MAX_ACCOUNT_STORAGE_MB=5120
RSAC_MAX_PROJECTS_PER_USER=20
RSAC_MAX_PAPERS_PER_PROJECT=20000
RSAC_RATE_LIMIT_ENABLED=true

# ── Backup Criptografado (age) ────────────────────────────────────────────────
# Chave pública age para cifra dos backups (o par privado NÃO fica no servidor)
# Gere no seu computador seguro com: age-keygen -o revsist_backup_key.txt
AGE_RECIPIENT_KEY=
