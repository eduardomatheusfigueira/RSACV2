# ==============================================================================
# Revsist — Caddyfile de Produção (TLS Automático, Proxy Reverso e Segurança)
# ==============================================================================
#
# Mapa de rotas — a mesma ordem que `backend/app/main.py` aplica quando o
# backend serve os arquivos sozinho, para que desenvolvimento e produção não
# discordem sobre o que responde em cada caminho:
#
#   /api/*        → backend
#   /health       → backend (o rodapé da landing lê a versão daqui)
#   /docs, /redoc, /openapi.json → backend
#   /assets/*     → landing primeiro, SPA em seguida
#   /app, /app/*  → SPA React (roteamento por hash, um único index.html)
#   tudo o mais   → landing estática (raiz, /termos, /privacidade)
# ==============================================================================

{
    # Configurações globais
    admin off
    email {$RSAC_CONTACT_EMAIL:contato@revsist.org}
    log {
        output stdout
        format json
    }
}

{$RSAC_PUBLIC_DOMAIN:localhost} {
    # ── Cabeçalhos Globais de Segurança (doc 29 §29.6) ────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # ── Compressão ────────────────────────────────────────────────────────────
    encode zstd gzip

    # ── Limite do Corpo da Requisição (doc 40 §40.7.5) ────────────────────────
    # 60 MB para acomodar PDFs até 50 MB mais envelope multipart/form-data
    request_body {
        max_size 60MB
    }

    # ── Rota da API e WebSockets ──────────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Configurações de timeout para operações pesadas (coleta / extração)
            transport http {
                response_header_timeout 300s
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    # ── Health check ──────────────────────────────────────────────────────────
    # Servido pelo backend, e não pelo Caddy: o que interessa saber é se a
    # aplicação responde, não se o proxy está de pé.
    handle /health {
        reverse_proxy api:8000
    }

    # ── Documentação OpenAPI e Swagger (apenas se liberado no backend) ─────────
    handle /docs* {
        reverse_proxy api:8000
    }
    handle /redoc* {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }

    # ── Recursos compilados ───────────────────────────────────────────────────
    # Landing e SPA compilam para `/assets/` cada uma no seu diretório, com nome
    # com hash — não colidem. `pass_thru` faz o primeiro `file_server` devolver
    # o controle quando não acha o arquivo, em vez de responder 404: é o que
    # permite tentar os dois diretórios em ordem.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"

        root * /srv/landing
        file_server {
            pass_thru
        }

        root * /srv/frontend
        file_server
    }

    # ── Aplicação Frontend SPA (React) ────────────────────────────────────────
    # O roteador é de hash: qualquer caminho sob /app devolve o mesmo documento.
    handle /app* {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    # ── Landing Page institucional e documentos de governança ─────────────────
    # `{path}/index.html` é o que faz `/termos` e `/privacidade` funcionarem sem
    # extensão, do jeito que os links da página e o sitemap declaram.
    handle {
        root * /srv/landing

        # Documento é revalidado com frequência; o recurso com hash, não.
        header Cache-Control "public, max-age=300"

        # CSP da landing como cabeçalho. A página também traz um <meta> com a
        # mesma política, mas `frame-ancestors` só vale por cabeçalho — e é
        # aqui, e não no bloco global, porque a SPA tem política própria, mais
        # larga, e as duas se somariam pela mais restritiva.
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

        try_files {path} {path}/index.html {path}.html /index.html
        file_server
    }
}
